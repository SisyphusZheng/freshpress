{
  "name": "@freshpress/plugin-ssg",
  "version": "0.1.3",
  "license": "MIT",
  "exports": "./src/mod.ts",
  "compilerOptions": {
    "lib": ["dom", "dom.asynciterable", "deno.ns", "deno.unstable"],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": ["a", "img", "source", "body", "html", "head"]
  },
  "tasks": {
    "dev": "deno run --watch -A src/mod.ts",
    "test": "deno test -A"
  },
  "imports": {
    "@std/fs": "jsr:@std/fs@1",
    "@std/fs/copy": "jsr:@std/fs@1/copy",
    "@std/fs/empty-dir": "jsr:@std/fs@1/empty-dir",
    "@std/path": "jsr:@std/path@1",
    "fresh": "jsr:@fresh/core@^2.0.0-alpha.46"
  },
  "lint": {
    "rules": {
      "tags": ["recommended", "fresh", "jsr", "jsx", "react"],
      "exclude": ["no-window"],
      "include": ["no-console"]
    }
  }
}
