{
  "name": "@freshpress/init",
  "version": "0.1.1",
  "license": "MIT",
  "exports": "./src/mod.ts",
  "compilerOptions": {
    "lib": ["dom", "dom.asynciterable", "deno.ns", "deno.unstable"],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": ["a", "img", "source", "body", "html", "head"]
  },
  "exclude": ["**/tmp/*"],
  "publish": {
    "include": ["src/**/*.ts", "deno.json", "README.md"],
    "exclude": ["**/*_test.*", "*.todo"]
  },
  "imports": {
    "@std/fmt/colors": "jsr:@std/fmt@^1.0.8/colors",
    "@std/path": "jsr:@std/path@1",
    "@std/cli/parse-args": "jsr:@std/cli@^1.0.21/parse-args",
    "@deno/gfm": "jsr:@deno/gfm@0.11.0"
  }
}
