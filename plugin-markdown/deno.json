{
  "name": "@freshpress/plugin-markdown",
  "version": "0.1.3",
  "license": "MIT",
  "exports": "./src/mod.ts",
  "compilerOptions": {
    "lib": ["dom", "dom.asynciterable", "deno.ns", "deno.unstable"],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": ["a", "img", "source", "body", "html", "head"]
  },
  "tasks": {
    "dev": "deno run --watch -A src/mod.ts",
    "test": "deno test -A"
  },
  "imports": {
    "@std/path": "jsr:@std/path@1",
    "@std/fs": "jsr:@std/fs@1",
    "@std/fs/expand-glob": "jsr:@std/fs@1/expand-glob",
    "@std/front-matter": "jsr:@std/front-matter@^1.0.0",
    "gfm": "jsr:@deno/gfm@0.11.0",
    "preact": "npm:preact@^10.26.9",
    "fresh": "jsr:@fresh/core@^2.0.0-alpha.46"
  }
}
